# Permite ao usuário jarvis reiniciar SÓ o serviço wecare-onboarding-staging
# sem senha, pra o cron do auto-deploy-staging.sh (rodando como jarvis) poder
# chamar systemctl restart.
# Instalar com: sudo cp deploy/sudoers/wecare-onboarding-staging-deploy /etc/sudoers.d/
#               sudo chmod 440 /etc/sudoers.d/wecare-onboarding-staging-deploy
#               sudo visudo -c
jarvis ALL=(root) NOPASSWD: /usr/bin/systemctl restart wecare-onboarding-staging
